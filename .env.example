# ── Spaceship ──────────────────────────────────────────────
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=
# Contact ID lấy từ lệnh: npm run contacts
SPACESHIP_CONTACT_ID=
# Mặc định public (không tính phí privacy). Chỉ set high nếu cố ý: SPACESHIP_PRIVACY_LEVEL=high

# ── Cloudflare ─────────────────────────────────────────────
# Freze: Pages + zone Freze
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
# Admin: tìm zone Admin + sửa DNS; custom domain vẫn gắn Pages Freze
CLOUDFLARE_ADMIN_API_TOKEN=
CLOUDFLARE_ADMIN_ACCOUNT_ID=ddead9accc534c1eb074d2a46fffe748
# Git-only mặc định: KHÔNG deploy bằng wrangler từ folder local
ALLOW_WRANGLER_DEPLOY=false

# ── GitHub (update domains.json) ─────────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
DOMAINS_JSON_PATH=domains.json

# ── Auth / Wallet security ─────────────────────────────────
JWT_SECRET=
# Secret header x-webhook-secret (hoặc Bearer) cho POST /api/wallet/webhook-pay
WALLET_WEBHOOK_SECRET=
# Chỉ bật local/dev: admin mới gọi được /api/wallet/simulate-pay
ALLOW_SIMULATE_PAY=false
